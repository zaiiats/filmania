generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  google
  github
}

model User {
  id        String      @id @default(cuid())
  username  String   @unique
  email     String   @unique
  profilePicture String @default("https://cdytzhprdbfgsngrvxdt.supabase.co/storage/v1/object/public/usersProfile/defaultUser.jpg")
  dateOfBirth DateTime?

  createdAt DateTime @default(now())

  passwordReset PasswordReset[]
  emailVerify EmailVerify[]
  session Session[]
  auth Auth?
  oAuthAccount OAuthAccount[]
  Review UserReview[]
}

model Auth {
  user_id String @id
  password_hash String
  email_verified Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Session {
  id String @id @default(cuid())
  user_id String
  is_persistent Boolean
  token_hash String @unique
  expires_at DateTime
  ip_address String?
  revoked_at DateTime? 
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([token_hash])
}

model EmailVerify {
  id String @id @default(cuid())
  user_id String @unique
  token_hash String @unique
  expires_at DateTime
  attempts Int?
  blocked_until DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id String @id @default(cuid())
  user_id String @unique
  token_hash String @unique
  expires_at DateTime
  attempts Int?
  blocked_until DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id String @id @default(cuid())
  providerAccountId String
  provider Provider
  user_id String
  createdAt DateTime @default(now())

  user User @relation(fields: [user_id],references: [id], onDelete: Cascade)  

  @@unique([user_id, provider])
  @@unique([provider, providerAccountId])
}


model UserReview {
  id String @id @default(cuid())
  movieExtId String
  userId String
  review String
  rating Int
  fileName String?

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@unique([userId, movieExtId])
  @@index([movieExtId])
  @@index([userId])
}